
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Tasks {
  id  Int   @id @default(autoincrement())
  title String
  completed Boolean @default(false)
  priority String
}